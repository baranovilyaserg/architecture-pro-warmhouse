{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceController WebSocket Telemetry Message",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "integer",
      "description": "ID of the device"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of telemetry generation"
    },
    "parameter": {
      "type": "string",
      "description": "Type of telemetry parameter (e.g. bulb, gates)"
    },
    "value": {
      "type": "string",
      "description": "Telemetry value (e.g. on/off, open/closed)"
    }
  },
  "required": ["device_id", "timestamp", "parameter", "value"]
}
